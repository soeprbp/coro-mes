@page "/admin"
@page "/admin/equipment"
@page "/admin/upkeep"
@page "/admin/alarms"
@page "/admin/protocols"
@page "/admin/settings"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "AdminOnly")]
@inject IEquipmentRepository EquipmentRepository
@inject IUpkeepIntegration UpkeepIntegration
@inject IAlarmService AlarmService
@inject IAlertDispatcher AlertDispatcher
@inject IAuditLogService AuditLog
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation

<div class="app-shell">
    <aside class="sidebar">
        <div class="brand"><span class="brand-mark">C</span><span>CoroMES</span></div>
        <nav>
            <a class="@NavClass("dashboard")" href="/admin">Dashboard</a>
            <a class="@NavClass("equipment")" href="/admin/equipment">Equipment</a>
            <a class="@NavClass("upkeep")" href="/admin/upkeep">Upkeep Sync</a>
            <a class="@NavClass("alarms")" href="/admin/alarms">Alarms</a>
            <a class="@NavClass("protocols")" href="/admin/protocols">Protocols</a>
            <a class="@NavClass("settings")" href="/admin/settings">Settings</a>
            <a href="/logout">Sign Out</a>
        </nav>
    </aside>

    <main class="workspace">
        @if (section == "dashboard")
        {
            <header class="page-header">
                <div><p class="eyebrow">Admin</p><h1>Equipment Overview</h1></div>
                <a class="button primary" href="/admin/equipment">Add Equipment</a>
            </header>

            <section class="metric-grid">
                <article class="metric"><span>Total Equipment</span><strong>@equipment.Count</strong></article>
                <article class="metric"><span>Running</span><strong>@equipment.Count(e => e.Status == EquipmentStatus.Running)</strong></article>
                <article class="metric"><span>Down</span><strong>@equipment.Count(e => e.Status == EquipmentStatus.Down)</strong></article>
                <article class="metric"><span>Linked to Upkeep</span><strong>@equipment.Count(e => e.UpkeepAssetId.HasValue)</strong></article>
                <article class="metric"><span>Active Alarms</span><strong>@alarms.Count(a => a.Status == AlarmStatus.Active)</strong></article>
            </section>

            <section class="panel">
                <div class="panel-title"><h2>Recent Activity</h2></div>
                <div class="activity-list">
                    @if (equipment.Count == 0)
                    {
                        <p class="muted">No equipment has been registered yet.</p>
                    }
                    else
                    {
                        @foreach (var item in equipment.Take(6))
                        {
                            <div class="activity-row">
                                <span class="status-dot @StatusClass(item.Status)"></span>
                                <span>@item.Code</span>
                                <strong>@item.Name</strong>
                                <span>@item.Status</span>
                            </div>
                        }
                    }
                </div>
            </section>
        }
        else if (section == "equipment")
        {
            <header class="page-header">
                <div><p class="eyebrow">Assets</p><h1>Equipment Management</h1></div>
                <button class="button primary" @onclick="NewEquipment">New</button>
            </header>

            <section class="split-layout wide-form">
                <div class="panel">
                    <div class="panel-title"><h2>@(editingId.HasValue ? "Edit Equipment" : "Add Equipment")</h2></div>
                    <div class="form-grid">
                        <label>Code <input @bind="form.Code" /></label>
                        <label>Name <input @bind="form.Name" /></label>
                        <label>Location <input @bind="form.Location" placeholder="Building, line, or area" /></label>
                        <label>IP Address <input @bind="form.IpAddress" /></label>
                        <label>Protocol <input @bind="form.Protocol" placeholder="auto, mqtt, opcua" /></label>
                        <label>Parts/Minute <input type="number" @bind="form.PartsPerMinute" /></label>
                        <label>Sq Ft/Day <input type="number" @bind="form.SqFtPerDay" /></label>
                        <label>Cycle Seconds <input type="number" @bind="form.CycleTimeSeconds" /></label>
                        <label>
                            Type
                            <select @bind="form.Type">
                                @foreach (var value in Enum.GetValues<EquipmentType>())
                                {
                                    <option value="@value">@value</option>
                                }
                            </select>
                        </label>
                        <label>
                            Status
                            <select @bind="form.Status">
                                @foreach (var value in Enum.GetValues<EquipmentStatus>())
                                {
                                    <option value="@value">@value</option>
                                }
                            </select>
                        </label>
                    </div>
                    <div class="match-box">
                        <div class="panel-title compact">
                            <div>
                                <h3>UpKeep Asset Match</h3>
                                <p class="muted">Link this MES equipment record to its CMMS asset.</p>
                            </div>
                            @if (form.UpkeepAssetId.HasValue)
                            {
                                <button class="button small" @onclick="ClearUpkeepMatch">Unmatch</button>
                            }
                        </div>

                        <label>Search UpKeep assets <input @bind="upkeepSearch" @bind:event="oninput" placeholder="Search by asset, location, or id" /></label>

                        @if (selectedUpkeepAsset is not null)
                        {
                            <div class="selected-match">
                                <span class="pill good">Matched</span>
                                <strong>@selectedUpkeepAsset.Name</strong>
                                <span>@selectedUpkeepAsset.Location</span>
                                <code>@selectedUpkeepAsset.Id</code>
                            </div>
                        }
                        else
                        {
                            <p class="muted">No UpKeep asset selected.</p>
                        }

                        <div class="asset-picker">
                            @foreach (var asset in FilteredUpkeepAssets)
                            {
                                var isSelected = form.UpkeepAssetId == asset.Id;
                                var isSuggested = SuggestedUpkeepAssets.Any(match => match.Id == asset.Id);
                                <button class="asset-option @(isSelected ? "selected" : string.Empty)" @onclick="() => SelectUpkeepAsset(asset.Id)">
                                    <span>
                                        <strong>@asset.Name</strong>
                                        <small>@asset.Type - @asset.Location</small>
                                    </span>
                                    <span class="asset-badges">
                                        @if (isSuggested)
                                        {
                                            <span class="pill warn">Suggested</span>
                                        }
                                        <code>@asset.Id</code>
                                    </span>
                                </button>
                            }
                        </div>
                    </div>
                    <div class="action-row">
                        <button class="button primary" @onclick="SaveEquipment">Save</button>
                        <button class="button" @onclick="NewEquipment">Clear</button>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(message))
                    {
                        <p class="notice">@message</p>
                    }
                </div>

                <div class="panel">
                    <div class="panel-title">
                        <h2>Registered Equipment</h2>
                        <button class="button icon" title="Refresh" @onclick="LoadEquipment">Refresh</button>
                    </div>
                    <div class="table-wrap">
                        <table>
                            <thead><tr><th>Code</th><th>Name</th><th>Status</th><th>Protocol</th><th>UpKeep</th><th></th></tr></thead>
                            <tbody>
                                @foreach (var item in equipment)
                                {
                                    var match = GetUpkeepAsset(item.UpkeepAssetId);
                                    <tr>
                                        <td>@item.Code</td>
                                        <td>@item.Name</td>
                                        <td><span class="pill @StatusClass(item.Status)">@item.Status</span></td>
                                        <td>@(item.Protocol ?? "manual")</td>
                                        <td>
                                            @if (match is null)
                                            {
                                                <span class="pill neutral">Unmatched</span>
                                            }
                                            else
                                            {
                                                <span class="linked-asset">@match.Name <code>@match.Id</code></span>
                                            }
                                        </td>
                                        <td class="row-actions">
                                            <button class="button small" @onclick="() => EditEquipment(item)">Edit</button>
                                            <button class="button small danger" @onclick="() => DeleteEquipment(item.Id)">Delete</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </section>
        }
        else if (section == "upkeep")
        {
            <header class="page-header">
                <div><p class="eyebrow">Integration</p><h1>Upkeep Sync</h1></div>
                <button class="button primary" @onclick="SyncUpkeep">Sync Now</button>
            </header>
            <section class="panel">
                <div class="panel-title"><h2>Available Upkeep Assets</h2></div>
                <div class="asset-grid">
                    @foreach (var asset in upkeepAssets)
                    {
                        <article class="asset-card">
                            <strong>@asset.Name</strong><span>@asset.Type</span><span>@asset.Location</span><code>@asset.Id</code>
                            <span class="pill @UpkeepAssetStatusClass(asset.Id)">@UpkeepAssetStatusLabel(asset.Id)</span>
                        </article>
                    }
                </div>
                <p class="notice">@syncStatus</p>
            </section>
        }
        else if (section == "alarms")
        {
            <header class="page-header">
                <div><p class="eyebrow">Alerts</p><h1>Alarms</h1></div>
                <button class="button primary" @onclick="RaiseAlarm">Raise Alarm</button>
            </header>

            <section class="split-layout wide-form">
                <div class="panel">
                    <div class="panel-title"><h2>New Alarm</h2><span class="pill neutral">@AlertDispatcher.Mode</span></div>
                    <div class="form-grid">
                        <label>Title <input @bind="alarmDraft.Title" /></label>
                        <label>
                            Severity
                            <select @bind="alarmDraft.Severity">
                                @foreach (var value in Enum.GetValues<AlarmSeverity>())
                                {
                                    <option value="@value">@value</option>
                                }
                            </select>
                        </label>
                        <label>
                            Equipment
                            <select @bind="alarmDraft.EquipmentId">
                                <option value="">None</option>
                                @foreach (var item in equipment)
                                {
                                    <option value="@item.Id">@item.Code - @item.Name</option>
                                }
                            </select>
                        </label>
                        <label>Source <input @bind="alarmDraft.Source" /></label>
                    </div>
                    <label>Message <textarea @bind="alarmDraft.Message" rows="4"></textarea></label>

                    <div class="settings-list channel-list">
                        @foreach (var channel in alarmChannels)
                        {
                            <label class="toggle-row">
                                <span>
                                    <strong>@channel.Label</strong>
                                    <small>@channel.Description</small>
                                </span>
                                <input type="checkbox" @bind="channel.Enabled" />
                            </label>
                        }
                    </div>

                    @if (!string.IsNullOrWhiteSpace(alarmMessage))
                    {
                        <p class="notice">@alarmMessage</p>
                    }
                </div>

                <div class="panel">
                    <div class="panel-title">
                        <h2>Recent Alarms</h2>
                        <button class="button icon" title="Refresh" @onclick="LoadAlarms">Refresh</button>
                    </div>
                    <div class="alarm-list">
                        @if (alarms.Count == 0)
                        {
                            <p class="muted">No alarms have been raised yet.</p>
                        }
                        else
                        {
                            @foreach (var alarm in alarms)
                            {
                                <article class="alarm-card @AlarmSeverityClass(alarm.Severity)">
                                    <div>
                                        <span class="pill @AlarmSeverityClass(alarm.Severity)">@alarm.Severity</span>
                                        <span class="pill @AlarmStatusClass(alarm.Status)">@alarm.Status</span>
                                    </div>
                                    <h3>@alarm.Title</h3>
                                    <p>@alarm.Message</p>
                                    <small>@alarm.Source - @alarm.TriggeredAtUtc.ToLocalTime():g</small>
                                    @if (!string.IsNullOrWhiteSpace(alarm.AlertChannels))
                                    {
                                        <code>@alarm.AlertChannels</code>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(alarm.NotificationSummary))
                                    {
                                        <small>@alarm.NotificationSummary</small>
                                    }
                                    <div class="row-actions">
                                        @if (alarm.Status == AlarmStatus.Active)
                                        {
                                            <button class="button small" @onclick="() => AcknowledgeAlarm(alarm.Id)">Acknowledge</button>
                                        }
                                        @if (alarm.Status != AlarmStatus.Resolved)
                                        {
                                            <button class="button small" @onclick="() => ResolveAlarm(alarm.Id)">Resolve</button>
                                        }
                                    </div>
                                </article>
                            }
                        }
                    </div>
                </div>
            </section>
        }
        else if (section == "protocols")
        {
            <header class="page-header">
                <div><p class="eyebrow">Connectivity</p><h1>Protocol Settings</h1></div>
                <button class="button primary" @onclick="SaveProtocolSettings">Save</button>
            </header>
            <section class="protocol-grid">
                @foreach (var setting in protocolSettings)
                {
                    <article class="panel">
                        <div class="panel-title"><h2>@setting.Name</h2><label class="toggle"><input type="checkbox" @bind="setting.Enabled" /> Enabled</label></div>
                        <label>Host <input @bind="setting.Host" /></label>
                        <label>Port <input type="number" @bind="setting.Port" /></label>
                    </article>
                }
            </section>
            <p class="notice">@protocolMessage</p>
        }
        else if (section == "settings")
        {
            <header class="page-header">
                <div><p class="eyebrow">System</p><h1>Settings</h1></div>
                <button class="button primary" @onclick="SaveSystemSettings">Save</button>
            </header>
            <section class="split-layout">
                <div class="panel">
                    <div class="panel-title"><h2>Integration Endpoints</h2></div>
                    <div class="form-grid">
                        @foreach (var endpoint in integrationEndpoints)
                        {
                            <label>
                                @endpoint.Name
                                <input @bind="endpoint.BaseUrl" placeholder="@endpoint.Placeholder" />
                            </label>
                            <label>
                                Mode
                                <select @bind="endpoint.Mode">
                                    <option value="disabled">Disabled</option>
                                    <option value="mock">Mock</option>
                                    <option value="read-only">Read Only</option>
                                    <option value="enabled">Enabled</option>
                                </select>
                            </label>
                        }
                    </div>
                    <p class="muted">Endpoint settings are scaffolding for the forward branch. Do not enter secrets or RTSP credentials here.</p>
                </div>

                <div class="panel">
                    <div class="panel-title"><h2>Feature Flags</h2></div>
                    <div class="settings-list">
                        @foreach (var flag in featureFlags)
                        {
                            <label class="toggle-row">
                                <span>
                                    <strong>@flag.Name</strong>
                                    <small>@flag.Description</small>
                                </span>
                                <input type="checkbox" @bind="flag.Enabled" />
                            </label>
                        }
                    </div>
                </div>
            </section>

            <section class="panel narrow">
                <div class="panel-title"><h2>Security</h2></div>
                <label>API Base URL <input value="http://localhost:5000" readonly /></label>
                <label>Admin Mode <input value="First auth gate enabled" readonly /></label>
                <p class="muted">This Blazor page is protected by the migration admin gate. Replace the access-code flow with enterprise identity before production use.</p>
                <p class="notice">@settingsMessage</p>
            </section>
        }
    </main>
</div>

@code {
    private readonly List<ProtocolSetting> protocolSettings =
    [
        new("MQTT", true, "localhost", 1883),
        new("OPC-UA", false, "opc.tcp://localhost", 4840),
        new("Ethernet/IP", false, "192.168.1.10", 44818)
    ];

    private readonly List<IntegrationEndpointSetting> integrationEndpoints =
    [
        new("MES-Vision i3X", "http://localhost:5002/v1/", "read-only", "http://localhost:5002/v1/"),
        new("MES-Vision Dashboard", "http://localhost:5000/", "disabled", "http://localhost:5000/"),
        new("UpKeep", "", "mock", "https://api.onupkeep.com/")
    ];

    private readonly List<FeatureFlagSetting> featureFlags =
    [
        new("Blazor display persistence", "Save shop-floor display definitions in CoroMES.", true),
        new("MES-Vision collector", "Enable the future read-only vision telemetry collector.", false),
        new("Alarm alerting", "Route alarm events to configured notification channels.", true),
        new("i3X repository mode", "Use i3X-backed repositories instead of EF-backed repositories.", false),
        new("Enterprise identity", "Replace the migration access-code gate.", false)
    ];

    private List<Equipment> equipment = [];
    private List<UpkeepAsset> upkeepAssets = [];
    private List<AlarmEvent> alarms = [];
    private Equipment form = new();
    private AlarmDraft alarmDraft = new();
    private int? editingId;
    private string section = "dashboard";
    private string? message;
    private string syncStatus = "Last sync: Never";
    private string? protocolMessage;
    private string? settingsMessage;
    private string? alarmMessage;
    private string upkeepSearch = string.Empty;
    private UpkeepAsset? selectedUpkeepAsset => GetUpkeepAsset(form.UpkeepAssetId);
    private readonly List<AlertChannelDraft> alarmChannels =
    [
        new("email", "Email", "Maintenance and production inboxes.", true),
        new("sms", "SMS", "Critical phone escalation.", false),
        new("pushover", "Pushover", "Mobile push notification.", false),
        new("upkeep", "UpKeep", "Create or update a CMMS event.", false)
    ];

    private IEnumerable<UpkeepAsset> SuggestedUpkeepAssets
    {
        get
        {
            if (string.IsNullOrWhiteSpace(form.Code) && string.IsNullOrWhiteSpace(form.Name))
            {
                return [];
            }

            return upkeepAssets
                .Select(asset => new { Asset = asset, Score = UpkeepMatchScore(asset) })
                .Where(match => match.Score > 0)
                .OrderByDescending(match => match.Score)
                .ThenBy(match => match.Asset.Name)
                .Take(3)
                .Select(match => match.Asset);
        }
    }

    private IEnumerable<UpkeepAsset> FilteredUpkeepAssets
    {
        get
        {
            var query = upkeepSearch.Trim();
            var assets = string.IsNullOrWhiteSpace(query)
                ? upkeepAssets
                : upkeepAssets.Where(asset =>
                    asset.Id.ToString().Contains(query, StringComparison.OrdinalIgnoreCase) ||
                    asset.Name.Contains(query, StringComparison.OrdinalIgnoreCase) ||
                    asset.Type.Contains(query, StringComparison.OrdinalIgnoreCase) ||
                    asset.Location.Contains(query, StringComparison.OrdinalIgnoreCase));

            var suggestedIds = SuggestedUpkeepAssets.Select(asset => asset.Id).ToHashSet();
            return assets
                .OrderByDescending(asset => form.UpkeepAssetId == asset.Id)
                .ThenByDescending(asset => suggestedIds.Contains(asset.Id))
                .ThenBy(asset => asset.Name);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        section = ResolveSection();
        upkeepAssets = (await UpkeepIntegration.GetAssetsAsync()).ToList();
        await LoadEquipment();
        await LoadAlarms();
    }

    protected override void OnParametersSet()
    {
        section = ResolveSection();
    }

    private string ResolveSection()
    {
        var path = new Uri(Navigation.Uri).AbsolutePath.Trim('/').ToLowerInvariant();
        return path switch
        {
            "admin/equipment" => "equipment",
            "admin/upkeep" => "upkeep",
            "admin/alarms" => "alarms",
            "admin/protocols" => "protocols",
            "admin/settings" => "settings",
            _ => "dashboard"
        };
    }

    private string NavClass(string target) => section == target ? "active" : string.Empty;

    private static string StatusClass(EquipmentStatus status) => status switch
    {
        EquipmentStatus.Running => "good",
        EquipmentStatus.Available => "good",
        EquipmentStatus.Idle => "warn",
        EquipmentStatus.Setup => "warn",
        EquipmentStatus.Down => "bad",
        EquipmentStatus.Maintenance => "bad",
        _ => "neutral"
    };

    private async Task LoadEquipment()
    {
        equipment = (await EquipmentRepository.GetAllAsync()).OrderBy(item => item.Code).ToList();
    }

    private async Task LoadAlarms()
    {
        alarms = (await AlarmService.GetRecentAsync(take: 50)).ToList();
    }

    private void NewEquipment()
    {
        editingId = null;
        form = new Equipment { Type = EquipmentType.Machine, Status = EquipmentStatus.Available, Protocol = "manual" };
        message = null;
        upkeepSearch = string.Empty;
    }

    private void EditEquipment(Equipment item)
    {
        editingId = item.Id;
        form = new Equipment
        {
            Id = item.Id,
            Code = item.Code,
            Name = item.Name,
            Location = item.Location,
            Type = item.Type,
            Status = item.Status,
            IpAddress = item.IpAddress,
            Protocol = item.Protocol,
            PartsPerMinute = item.PartsPerMinute,
            SqFtPerDay = item.SqFtPerDay,
            CycleTimeSeconds = item.CycleTimeSeconds,
            UpkeepAssetId = item.UpkeepAssetId
        };
        upkeepSearch = GetUpkeepAsset(item.UpkeepAssetId)?.Name ?? string.Empty;
        message = null;
    }

    private UpkeepAsset? GetUpkeepAsset(int? upkeepAssetId)
    {
        return upkeepAssetId.HasValue
            ? upkeepAssets.FirstOrDefault(asset => asset.Id == upkeepAssetId.Value)
            : null;
    }

    private void SelectUpkeepAsset(int upkeepAssetId)
    {
        form.UpkeepAssetId = upkeepAssetId;
        upkeepSearch = GetUpkeepAsset(upkeepAssetId)?.Name ?? string.Empty;
    }

    private void ClearUpkeepMatch()
    {
        form.UpkeepAssetId = null;
        upkeepSearch = string.Empty;
    }

    private int UpkeepMatchScore(UpkeepAsset asset)
    {
        var score = 0;

        if (!string.IsNullOrWhiteSpace(form.Name) &&
            asset.Name.Contains(form.Name, StringComparison.OrdinalIgnoreCase))
        {
            score += 4;
        }

        if (!string.IsNullOrWhiteSpace(form.Code) &&
            asset.Name.Contains(form.Code, StringComparison.OrdinalIgnoreCase))
        {
            score += 3;
        }

        if (!string.IsNullOrWhiteSpace(form.Location) &&
            asset.Location.Contains(form.Location, StringComparison.OrdinalIgnoreCase))
        {
            score += 2;
        }

        if (!string.IsNullOrWhiteSpace(form.Name))
        {
            var nameWords = form.Name.Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
            score += nameWords.Count(word => word.Length > 2 && asset.Name.Contains(word, StringComparison.OrdinalIgnoreCase));
        }

        return score;
    }

    private string UpkeepAssetStatusLabel(int upkeepAssetId)
    {
        return equipment.Any(item => item.UpkeepAssetId == upkeepAssetId) ? "Matched" : "Available";
    }

    private string UpkeepAssetStatusClass(int upkeepAssetId)
    {
        return equipment.Any(item => item.UpkeepAssetId == upkeepAssetId) ? "good" : "neutral";
    }

    private async Task SaveEquipment()
    {
        if (string.IsNullOrWhiteSpace(form.Code) || string.IsNullOrWhiteSpace(form.Name))
        {
            message = "Code and name are required.";
            return;
        }

        if (form.UpkeepAssetId.HasValue)
        {
            var duplicate = equipment.FirstOrDefault(item =>
                item.UpkeepAssetId == form.UpkeepAssetId &&
                item.Id != editingId);

            if (duplicate is not null)
            {
                message = $"UpKeep asset {form.UpkeepAssetId} is already matched to {duplicate.Code}.";
                return;
            }
        }

        if (editingId.HasValue)
        {
            var before = equipment.FirstOrDefault(item => item.Id == editingId.Value);
            await EquipmentRepository.UpdateAsync(form);
            await AuditLog.RecordAsync(null, new AuditLogEntry(
                "Update",
                nameof(Equipment),
                form.Id,
                $"{DescribeEquipment(before)} -> {DescribeEquipment(form)}",
                Actor: await GetCurrentActorAsync(),
                Route: "/admin/equipment"));
            message = $"{form.Code} updated.";
        }
        else
        {
            await EquipmentRepository.AddAsync(form);
            await AuditLog.RecordAsync(null, new AuditLogEntry(
                "Create",
                nameof(Equipment),
                form.Id,
                DescribeEquipment(form),
                Actor: await GetCurrentActorAsync(),
                Route: "/admin/equipment"));
            message = $"{form.Code} added.";
        }

        NewEquipment();
        await LoadEquipment();
    }

    private async Task DeleteEquipment(int id)
    {
        var deleted = equipment.FirstOrDefault(item => item.Id == id);
        await EquipmentRepository.DeleteAsync(id);
        await AuditLog.RecordAsync(null, new AuditLogEntry(
            "Delete",
            nameof(Equipment),
            id,
            DescribeEquipment(deleted),
            Actor: await GetCurrentActorAsync(),
            Route: "/admin/equipment"));
        await LoadEquipment();
    }

    private async Task SyncUpkeep()
    {
        var linkedEquipment = equipment
            .Where(item => item.UpkeepAssetId.HasValue)
            .Select(item => new UpkeepEquipmentLink(
                item.Id,
                item.Code,
                item.Name,
                item.UpkeepAssetId!.Value,
                item.Status.ToString(),
                item.Location))
            .ToList();

        var result = await UpkeepIntegration.SyncEquipmentAsync(new UpkeepSyncRequest(linkedEquipment));
        syncStatus = $"Last sync: {result.TimestampUtc.ToLocalTime():g}. Mode: {result.Mode}. Linked assets: {result.Synced}. {result.Message}";
    }

    private async Task RaiseAlarm()
    {
        if (string.IsNullOrWhiteSpace(alarmDraft.Title) || string.IsNullOrWhiteSpace(alarmDraft.Message))
        {
            alarmMessage = "Title and message are required.";
            return;
        }

        var channels = alarmChannels
            .Where(channel => channel.Enabled)
            .Select(channel => channel.Id)
            .ToList();

        var alarm = await AlarmService.RaiseAsync(new AlarmCreateRequest(
            alarmDraft.Title,
            alarmDraft.Message,
            alarmDraft.Severity,
            alarmDraft.Source,
            alarmDraft.EquipmentId,
            channels), await GetCurrentActorAsync());

        await AuditLog.RecordAsync(null, new AuditLogEntry(
            "Create",
            nameof(AlarmEvent),
            alarm.Id,
            $"Severity={alarm.Severity}; Source={alarm.Source}; Channels={alarm.AlertChannels ?? "none"}",
            Actor: await GetCurrentActorAsync(),
            Route: "/admin/alarms"));

        alarmMessage = $"Alarm {alarm.Id} raised. {alarm.NotificationSummary}";
        alarmDraft = new();
        await LoadAlarms();
    }

    private async Task AcknowledgeAlarm(int id)
    {
        var actor = await GetCurrentActorAsync();
        var alarm = await AlarmService.AcknowledgeAsync(id, actor);
        if (alarm is not null)
        {
            await AuditLog.RecordAsync(null, new AuditLogEntry(
                "Acknowledge",
                nameof(AlarmEvent),
                alarm.Id,
                $"Alarm acknowledged by {actor}.",
                Actor: actor,
                Route: "/admin/alarms"));
        }

        await LoadAlarms();
    }

    private async Task ResolveAlarm(int id)
    {
        var actor = await GetCurrentActorAsync();
        var alarm = await AlarmService.ResolveAsync(id, actor);
        if (alarm is not null)
        {
            await AuditLog.RecordAsync(null, new AuditLogEntry(
                "Resolve",
                nameof(AlarmEvent),
                alarm.Id,
                $"Alarm resolved by {actor}.",
                Actor: actor,
                Route: "/admin/alarms"));
        }

        await LoadAlarms();
    }

    private void SaveProtocolSettings()
    {
        protocolMessage = $"Protocol settings saved at {DateTime.Now:t}.";
    }

    private void SaveSystemSettings()
    {
        settingsMessage = $"Settings scaffold saved at {DateTime.Now:t}. Persistence and secret storage are still pending.";
    }

    private async Task<string> GetCurrentActorAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        return authState.User.Identity?.Name ?? "unknown";
    }

    private static string DescribeEquipment(Equipment? item)
    {
        if (item is null)
        {
            return "Equipment not found";
        }

        return $"Code={item.Code}; Name={item.Name}; Status={item.Status}; Location={item.Location ?? "n/a"}; UpKeepAssetId={item.UpkeepAssetId?.ToString() ?? "none"}";
    }

    private static string AlarmSeverityClass(AlarmSeverity severity) => severity switch
    {
        AlarmSeverity.Critical => "bad",
        AlarmSeverity.Warning => "warn",
        _ => "neutral"
    };

    private static string AlarmStatusClass(AlarmStatus status) => status switch
    {
        AlarmStatus.Active => "bad",
        AlarmStatus.Acknowledged => "warn",
        AlarmStatus.Resolved => "good",
        _ => "neutral"
    };

