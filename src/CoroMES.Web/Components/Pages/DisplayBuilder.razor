@page "/displays"
@page "/displays/builder"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "AdminOnly")]
@inject IEquipmentRepository EquipmentRepository
@inject ApplicationDbContext Db
@inject IAuditLogService AuditLog
@inject AuthenticationStateProvider AuthenticationStateProvider

<div class="display-admin">
    <aside class="sidebar compact">
        <div class="brand"><span class="brand-mark">D</span><span>Displays</span></div>
        <nav>
            <a class="active" href="/displays/builder">Builder</a>
            <a href="/displays/viewer?id=preview&type=oee">Preview</a>
            <a href="/admin">Admin</a>
        </nav>
    </aside>

    <main class="workspace">
        <header class="page-header">
            <div><p class="eyebrow">Shop Floor</p><h1>Display Builder</h1></div>
            <button class="button primary" @onclick="CreateDisplay">Create Display</button>
        </header>

        <section class="split-layout">
            <div class="panel">
                <div class="panel-title"><h2>Configure</h2></div>
                <div class="form-grid">
                    <label>Name <input @bind="draft.Name" /></label>
                    <label>
                        Type
                        <select @bind="draft.Type">
                            <option value="oee">OEE</option>
                            <option value="production">Production</option>
                            <option value="quality">Quality</option>
                            <option value="equipment">Equipment</option>
                        </select>
                    </label>
                    <label>Refresh Seconds <input type="number" @bind="draft.RefreshSeconds" /></label>
                    <label>
                        Equipment
                        <select @bind="draft.EquipmentId">
                            <option value="">None</option>
                            @foreach (var item in equipment)
                            {
                                <option value="@item.Id">@item.Code - @item.Name</option>
                            }
                        </select>
                    </label>
                </div>
                <div class="action-row">
                    <button class="button primary" @onclick="CreateDisplay">Save</button>
                    <a class="button" href="@PreviewUrl">Preview</a>
                </div>
            </div>

            <div class="panel">
                <div class="panel-title"><h2>My Displays</h2></div>
                <div class="display-list">
                    @foreach (var display in displays)
                    {
                        <article class="display-row">
                            <div>
                                <strong>@display.Name</strong>
                                <span>@display.Type.ToUpperInvariant() - @display.RefreshSeconds sec</span>
                            </div>
                            <a class="button small" href="@ViewerUrl(display)">Open</a>
                        </article>
                    }
                </div>
            </div>
        </section>
    </main>
</div>

@code {
    private List<Equipment> equipment = [];
    private List<DisplayDefinition> displays = [];
    private DisplayDraft draft = new() { Name = "Line 1 OEE", Type = "oee", RefreshSeconds = 5 };

    private string PreviewUrl => $"/displays/viewer?id=preview&type={draft.Type}&name={Uri.EscapeDataString(draft.Name)}";

    protected override async Task OnInitializedAsync()
    {
        equipment = (await EquipmentRepository.GetAllAsync()).OrderBy(item => item.Code).ToList();
        await LoadDisplays();
    }

    private async Task LoadDisplays()
    {
        displays = await Db.DisplayDefinitions
            .AsNoTracking()
            .Where(display => display.IsActive)
            .OrderBy(display => display.Name)
            .ToListAsync();
    }

    private async Task CreateDisplay()
    {
        var saved = new DisplayDefinition
        {
            Slug = await CreateUniqueSlugAsync(draft.Name),
            Name = string.IsNullOrWhiteSpace(draft.Name) ? "New Display" : draft.Name.Trim(),
            Type = CleanType(draft.Type),
            RefreshSeconds = Math.Max(1, draft.RefreshSeconds),
            EquipmentId = draft.EquipmentId,
            IsActive = true,
            CreatedAt = DateTime.UtcNow
        };

        Db.DisplayDefinitions.Add(saved);
        await Db.SaveChangesAsync();
        await AuditLog.RecordAsync(null, new AuditLogEntry(
            "Create",
            nameof(DisplayDefinition),
            saved.Id,
            DescribeDisplay(saved),
            Actor: await GetCurrentActorAsync(),
            Route: "/displays/builder"));
        await LoadDisplays();
        draft = new DisplayDraft { Name = "New Display", Type = "oee", RefreshSeconds = 5 };
    }

    private static string ViewerUrl(DisplayDefinition display)
    {
        return $"/displays/viewer?id={display.Slug}";
    }

    private async Task<string> CreateUniqueSlugAsync(string? name)
    {
        var root = Slugify(string.IsNullOrWhiteSpace(name) ? "New Display" : name);
        var slug = root;
        var suffix = 1;

        while (await Db.DisplayDefinitions.AnyAsync(display => display.Slug == slug))
        {
            suffix++;
            slug = $"{root}-{suffix}";
        }

        return slug;
    }

    private static string CleanType(string? type)
    {
        var value = string.IsNullOrWhiteSpace(type) ? "oee" : type.Trim().ToLowerInvariant();
        return value is "oee" or "production" or "quality" or "equipment" ? value : "oee";
    }

    private static string Slugify(string value)
    {
        var chars = value
            .ToLowerInvariant()
            .Select(ch => char.IsLetterOrDigit(ch) ? ch : '-')
            .ToArray();

        var slug = string.Join('-', new string(chars).Split('-', StringSplitOptions.RemoveEmptyEntries));
        return string.IsNullOrWhiteSpace(slug) ? $"display-{DateTime.UtcNow:HHmmss}" : slug;
    }

    private async Task<string> GetCurrentActorAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        return authState.User.Identity?.Name ?? "unknown";
    }

    private static string DescribeDisplay(DisplayDefinition display)
    {
        return $"Slug={display.Slug}; Name={display.Name}; Type={display.Type}; RefreshSeconds={display.RefreshSeconds}; EquipmentId={display.EquipmentId?.ToString() ?? "none"}";
    }

    private sealed class DisplayDraft
    {
        public string Name { get; set; } = string.Empty;
        public string Type { get; set; } = "oee";
        public int RefreshSeconds { get; set; } = 5;
        public int? EquipmentId { get; set; }
    }
}
