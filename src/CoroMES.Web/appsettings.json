{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=database/coromes.db"
  },
  "DatabaseProvider": "sqlite",
  "i3x": {
    "enabled": false,
    "baseUrl": "http://localhost:8080/v1",
    "apiKey": "",
    "namespaceUri": "https://coromes.com/ns/mes",
    "autoRegisterTypes": true,
    "timeoutSeconds": 30
  },
  "Alerting": {
    "Mode": "mock",
    "DefaultChannels": [ "email" ],
    "CriticalChannels": [ "email", "sms", "pushover", "upkeep" ]
  }
}
